# Copia este archivo como .env (y como .env.test para las pruebas) y completa los valores.
# Ningún archivo .env se sube al repositorio.

NODE_ENV=development
PUERTO=3000

# PostgreSQL en Amazon RDS (privado: solo accesible desde EC2)
DB_HOST=gas-el-volcan-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=gas_el_volcan
DB_USER=gasadmin
DB_PASSWORD=
# Certificado de RDS: https://truststore.pki.rds.amazonaws.com/us-east-1/us-east-1-bundle.pem
DB_CA_PATH=/home/ubuntu/certs/us-east-1-bundle.pem

# JWT: clave aleatoria de 32 bytes en base64. Generarla con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRETO=
JWT_EMISOR=gas-el-volcan-api
JWT_AUDIENCIA=gas-el-volcan-web
JWT_DURACION_SEGUNDOS=900

# Orígenes del frontend permitidos por CORS, separados por coma
ORIGENES_PERMITIDOS=http://localhost:5173

# Contraseña ficticia para los perfiles de demostración que crea npm run sembrar
SEMILLA_CONTRASENA_DEMO=
